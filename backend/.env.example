# Copy to backend/.env (which is git-ignored) and fill in. Never commit real keys.

# Google Gemini API key from https://aistudio.google.com (free tier, no card).
GEMINI_API_KEY=

# Model id exactly as shown in Google AI Studio (use a Flash or Flash-Lite model).
GEMINI_MODEL=

# Gemini's OpenAI-compatible endpoint (verified by scripts/check_llm.py).
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
